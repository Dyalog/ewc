 R←msg WaitForWG arg;Props;ID;WGID;timeout;j;⎕TRAP;p;nl;nlc;m;t;token;wx;ref;ok;id;z
 (Props ID WGID timeout)←4↑arg,⊂WG_TIMEOUT

 wx←Props≡'WX' ⍝ A WX rather than a WG

 ⍝ Every request's reply has a token of its own, so only this thread can take it
 id←⊃2⊃⎕VFI⍕WGID
 token←WGID_TOKENBASE+WGID_TOKENSTEP×id
 j←timeout ⎕TGET token
 :Hold 'EWCWGID'
     PENDINGWGIDS~←id
     :If 0=≢j
         j←0 ⎕TGET token ⍝ In case the reply arrived as we timed out
     :EndIf
 :EndHold
 :If 0=≢j
     'W' Log 'Client did not respond within ',(⍕timeout),' seconds.'
     'W' Log 'Request was: ',msg
     ⎕SIGNAL 6
 :EndIf

 ref←j⍎(1+wx)⊃'WG' 'WX' ⍝ The reply: a WX if we sent a WX, else a WG
 :If wx
     →0⊣R←ref.Info
 :EndIf

 :If ∧/ok←(p←⎕C,⊆Props)∊nlc←⎕C nl←ref.Properties.⎕NL-2
     p←nl[nlc⍳p] ⍝ /// Should go when everything is lowercase
     R←ref.Properties⍎((1=≢p)/',⊂'),⍕p
     R←ref.ID MixTables p R
     :If 1=≡Props
         R←⊃R ⍝ A single simple property
     :EndIf
 :Else
     :If 2=ref.⎕NC 'NotSupported'
     :AndIf ∨/m←(t←Props~nl)∊ref.NotSupported
         ⍝ No value to return, so this stays fatal whatever EWC.UNSUPPORTED says
         z←'property'Unsupported('' ''(m/t)) ⍝ No object name reaches this far
         ('Property not supported by EWC: ',⍕m/t) ⎕SIGNAL 6
     :EndIf
     ('Not returned: ',,⍕(~ok)/,⊆Props) ⎕SIGNAL 6
 :EndIf
